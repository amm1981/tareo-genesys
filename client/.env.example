SQL_SERVER=192.168.136.3
SQL_PORT=1433
SQL_DATABASE=CASABLANCA
SQL_AUTH_MODE=sql
SQL_USERNAME=
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false
# Ruta opcional a la CA PEM, relativa a client/ o absoluta.
SQL_CA_FILE=
SQL_TLS_SERVER_NAME=
SQL_CONNECTION_TIMEOUT_MS=15000
SQL_REQUEST_TIMEOUT_MS=600000

API_BASE_URL=http://127.0.0.1:8000
API_TOKEN=
# Opcional para el modo manual; si se define, se relee el archivo en cada solicitud.
API_TOKEN_FILE=
SYNC_LOCK_PORT=47831
# Automatizacion: destino independiente del manual; token propio del VPS en archivo con ACL privada.
AUTO_API_BASE_URL=https://api.labour.agrocalera.app
AUTO_TOKEN_FILE=.secrets/vps-sync-token
AUTO_MIN_FREE_MB=1024
AUTO_MAX_SPOOL_MB=10240
AUTO_LOCAL_RETENTION_DAYS=14
BATCH_SIZE=1000
REQUEST_TIMEOUT_MS=60000
HTTP_RETRIES=3
MAX_BATCH_BYTES=4194304
# Generado con inspect:schema; revise y copie el mismo archivo al servidor.
SQL_SCHEMA_FILE=schema.spwconsumomes.json
