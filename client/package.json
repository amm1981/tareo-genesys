{
  "name": "get-genesys-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "sync": "tsx src/index.ts",
    "check:connection": "tsx src/index.ts --check-connection",
    "diagnose:connection": "tsx scripts/diagnose-connection.ts",
    "inspect:schema": "tsx src/index.ts --inspect-schema",
    "test": "vitest run"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.0",
    "mssql": "12.7.11",
    "tedious": "20.3.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.8",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "overrides": { "@azure/msal-node": "^7.1.1" }
}
