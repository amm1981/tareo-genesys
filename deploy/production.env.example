APP_NAME=GET_Genesys
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.labour.agrocalera.app
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=get_genesys
DB_USERNAME=get_genesys_app
DB_PASSWORD=__CONFIGURAR_SECRETO_EN_EL_VPS__
SESSION_DRIVER=file
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
SYNC_MAX_BODY_BYTES=12582912
SYNC_MAX_BATCH_BYTES=4194304
SYNC_MAX_ROWS=10000000
API_QUERY_TOKEN_TTL_MINUTES=60
# Ruta predeterminada: storage/app/private/source-schema.json.
# Si storage es un enlace al directorio compartido, copiar alli el esquema del paquete.
